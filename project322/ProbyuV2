import pygame
import sys
import random
import math

pygame.init()
pygame.mixer.init()

# Настройки окна 
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Artis Impact - Lite 123")

#  Цвета 
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GRAY = (100, 100, 100)
BLUE = (70, 130, 180)
RED = (220, 60, 60)
GREEN = (60, 220, 60)
ORANGE = (255, 140, 0)
PURPLE = (180, 60, 200)
YELLOW = (255, 220, 60)
CYAN = (0, 255, 255)

# Настройки 
class Settings:
    def __init__(self):
        self.volume = 50

settings = Settings()

# Локации 
LOCATIONS = {
    "forest": (34, 139, 34),
    "desert": (210, 180, 140),
    "city": (105, 105, 105),
}
current_location = "forest"


class Player:
    def __init__(self):
        self.x = SCREEN_WIDTH // 2
        self.y = SCREEN_HEIGHT // 2
        self.size = 40
        self.speed = 5
        self.alpha = 255  #прозрачностm

    def move(self, dx, dy):
        self.x = max(0, min(SCREEN_WIDTH - self.size, self.x + dx))
        self.y = max(0, min(SCREEN_HEIGHT - self.size, self.y + dy))

    def draw(self, surface):
        if self.alpha <= 0:
            return
        s = pygame.Surface((self.size, self.size), pygame.SRCALPHA)
        s.fill((*BLUE, self.alpha))
        surface.blit(s, (self.x, self.y))

    def get_center(self):
        return self.x + self.size // 2, self.y + self.size // 2

    def collides_with_rect(self, x, y, size):
        return (
            self.x < x + size and
            self.x + self.size > x and
            self.y < y + size and
            self.y + self.size > y
        )

    def collides_with_circle(self, cx, cy, radius):
        px, py = self.get_center()
        return math.hypot(px - cx, py - cy) <= radius

player = Player()

# Снаряд (для мага и босса) 
class Projectile:
    def __init__(self, x, y, dx, dy, speed, color, radius=6, lifetime=5.0):
        self.x = x
        self.y = y
        self.dx = dx
        self.dy = dy
        self.speed = speed
        self.color = color
        self.radius = radius
        self.lifetime = lifetime
        self.active = True

    def update(self, dt):
        self.x += self.dx * self.speed * dt
        self.y += self.dy * self.speed * dt
        self.lifetime -= dt
        if self.lifetime <= 0:
            self.active = False

    def draw(self, surface):
        pygame.draw.circle(surface, self.color, (int(self.x), int(self.y)), self.radius)

    def collides_with_player(self, player):
        return player.collides_with_circle(self.x, self.y, self.radius)

#Обычные враги 
class Enemy:
    def __init__(self, name, color, speed, has_ranged=False):
        self.name = name
        self.color = color
        self.size = 50
        self.x = random.randint(50, SCREEN_WIDTH - 100)
        self.y = random.randint(50, SCREEN_HEIGHT - 100)
        self.speed = speed
        self.has_ranged = has_ranged
        self.projectiles = []
        self.shoot_timer = 0
        self.shoot_interval = 2.0  # сек

    def update(self, player, dt):
        # Движение
        px, py = player.get_center()
        ex, ey = self.x + self.size // 2, self.y + self.size // 2
        dx, dy = px - ex, py - ey
        dist = max(0.1, math.hypot(dx, dy))
        self.x += (dx / dist) * self.speed
        self.y += (dy / dist) * self.speed

        # Дальняя атака (только у мага)
        if self.has_ranged:
            self.shoot_timer += dt
            if self.shoot_timer >= self.shoot_interval:
                angle = math.atan2(dy, dx)
                self.projectiles.append(Projectile(
                    ex, ey,
                    math.cos(angle), math.sin(angle),
                    speed=300,
                    color=CYAN,
                    radius=5,
                    lifetime=3.0
                ))
                self.shoot_timer = 0

        for proj in self.projectiles[:]:
            proj.update(dt)
            if not proj.active or proj.collides_with_player(player):
                if proj.collides_with_player(player):
                    return True
                self.projectiles.remove(proj)
        return False

    def draw(self, surface):
        pygame.draw.rect(surface, self.color, (self.x, self.y, self.size, self.size))
        for proj in self.projectiles:
            proj.draw(surface)

# Босс 
class Boss:
    def __init__(self):
        self.size = 80
        self.x = SCREEN_WIDTH // 2 - self.size // 2
        self.y = SCREEN_HEIGHT // 2 - self.size // 2
        self.color = PURPLE
        self.projectiles = []
        self.attack_cooldown = random.uniform(4.0, 6.0)
        self.time_since_attack = 0
        self.current_attack = None
        self.attack_timer = 0
        self.dash_target = None
        self.dash_line_visible = False

    def start_new_attack(self, player):
        self.current_attack = random.choice(["zone", "arrows", "dash", "daggers"])
        self.attack_timer = 0
        if self.current_attack == "dash":
            px, py = player.get_center()
            bx, by = self.x + self.size // 2, self.y + self.size // 2
            angle = math.atan2(py - by, px - bx)
            dist = 200
            self.dash_target = (
                bx + math.cos(angle) * dist,
                by + math.sin(angle) * dist
            )
            self.dash_line_visible = True

    def update(self, player, dt):
        self.time_since_attack += dt
        if self.current_attack is None and self.time_since_attack >= self.attack_cooldown:
            self.start_new_attack(player)

        if self.current_attack:
            self.attack_timer += dt

            if self.current_attack == "zone":
                if self.attack_timer >= 0.1:
                    if player.collides_with_circle(player.get_center()[0], player.get_center()[1], 80):
                        return True
                    self.current_attack = None
                    self.time_since_attack = 0

            elif self.current_attack == "arrows":
                if self.attack_timer >= 0.2:
                    center_x = self.x + self.size // 2
                    center_y = self.y + self.size // 2
                    for i in range(10):
                        angle = i * (2 * math.pi / 10)
                        self.projectiles.append(Projectile(
                            center_x, center_y,
                            math.cos(angle), math.sin(angle),
                            speed=400,
                            color=YELLOW,
                            radius=7,
                            lifetime=3.0
                        ))
                    self.current_attack = None
                    self.time_since_attack = 0

            elif self.current_attack == "dash":
                if self.attack_timer >= 1.0:
                    self.dash_line_visible = False
                    if self.dash_target:
                        self.x = self.dash_target[0] - self.size // 2
                        self.y = self.dash_target[1] - self.size // 2
                        if player.collides_with_rect(self.x, self.y, self.size):
                            return True
                    self.current_attack = None
                    self.time_since_attack = 0
                    self.dash_target = None

            elif self.current_attack == "daggers":
                if self.attack_timer >= 0.3:
                    center_x = self.x + self.size // 2
                    center_y = self.y + self.size // 2
                    px, py = player.get_center()
                    base_angle = math.atan2(py - center_y, px - center_x)
                    for offset in [-0.5, 0, 0.5]:
                        angle = base_angle + offset
                        self.projectiles.append(Projectile(
                            center_x, center_y,
                            math.cos(angle), math.sin(angle),
                            speed=350,
                            color=RED,
                            radius=6,
                            lifetime=3.0
                        ))
                    self.current_attack = None
                    self.time_since_attack = 0

        for proj in self.projectiles[:]:
            proj.update(dt)
            if not proj.active or proj.collides_with_player(player):
                if proj.collides_with_player(player):
                    return True
                self.projectiles.remove(proj)

        return False

    def draw(self, surface):
        pygame.draw.rect(surface, self.color, (self.x, self.y, self.size, self.size))
        if self.dash_line_visible and self.dash_target:
            bx, by = self.x + self.size // 2, self.y + self.size // 2
            pygame.draw.line(surface, YELLOW, (bx, by), self.dash_target, 3)
        for proj in self.projectiles:
            proj.draw(surface)

# UI 
font = pygame.font.SysFont(None, 72)  # Большой шрифт для вывода смерти
small_font = pygame.font.SysFont(None, 28)

#  Состояния
STATE_MENU = "menu"
STATE_LOCATIONS = "locations"
STATE_SETTINGS = "settings"
STATE_GAME = "game"
STATE_DYING = "dying"      
STATE_GAME_OVER = "game_over"
current_state = STATE_MENU

# Кнопки 
class Button:
    def __init__(self, x, y, w, h, text, font_size=36):
        self.font = pygame.font.SysFont(None, font_size)
        self.rect = pygame.Rect(x, y, w, h)
        self.text = text
    def draw(self, surface):
        pygame.draw.rect(surface, GRAY, self.rect)
        ts = self.font.render(self.text, True, WHITE)
        surface.blit(ts, (self.rect.centerx - ts.get_width()//2, self.rect.centery - ts.get_height()//2))
    def is_clicked(self, pos): return self.rect.collidepoint(pos)

class Slider:
    def __init__(self, x, y, w, h):
        self.rect = pygame.Rect(x, y, w, h)
        self.value = settings.volume
    def draw(self, surface):
        pygame.draw.rect(surface, GRAY, self.rect)
        px = self.rect.x + (self.value / 100) * self.rect.width
        pygame.draw.circle(surface, WHITE, (int(px), self.rect.centery), 10)
    def handle_event(self, x):
        rel = (x - self.rect.x) / self.rect.width
        self.value = max(0, min(100, rel * 100))
        settings.volume = int(self.value)

#  Кнопки v2
play_btn = Button(300, 180, 200, 50, "Играть")
loc_btn = Button(300, 250, 200, 50, "Локации")
set_btn = Button(300, 320, 200, 50, "Настройки")
quit_btn = Button(300, 390, 200, 50, "Выход")
back_btn = Button(300, 480, 200, 50, "Назад")
loc_buttons = [
    Button(100, 100, 150, 50, "Лес"),
    Button(100, 170, 150, 50, "Пустыня"),
    Button(100, 240, 150, 50, "Город"),
]
vol_slider = Slider(200, 250, 400, 20)

#  Игровые данные
enemy_types = [
    {"name": "Дуралей", "color": RED, "speed": 3.0, "ranged": False},
    {"name": "придумать имя надо", "color": ORANGE, "speed": 3.5, "ranged": False},
    {"name": "Казуал", "color": (100, 100, 255), "speed": 2.5, "ranged": True},
]

current_enemy_index = -1
enemy = None
boss = None
fight_mode = False
boss_fight = False
time_limit = 15
time_left = time_limit

# Переменные для анимации смерти
player_fade_alpha = 255
you_died_alpha = 0
you_died_y = SCREEN_HEIGHT + 50  # Начинаем за пределами экрана
dying_timer = 0
DYING_DURATION = 2.0  # секунды на всю анимацию

#  Цикл
clock = pygame.time.Clock()
last_time = pygame.time.get_ticks()
running = True

while running:
    dt = (pygame.time.get_ticks() - last_time) / 1000.0
    last_time = pygame.time.get_ticks()
    mouse_pos = pygame.mouse.get_pos()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if current_state == STATE_SETTINGS and event.type == pygame.MOUSEMOTION and pygame.mouse.get_pressed()[0]:
            vol_slider.handle_event(event.pos[0])
        if event.type == pygame.MOUSEBUTTONDOWN:
            if current_state == STATE_MENU:
                if play_btn.is_clicked(mouse_pos):
                    current_state = STATE_GAME
                    current_enemy_index = -1; enemy = None; boss = None
                    fight_mode = False; boss_fight = False; time_left = time_limit
                    player.alpha = 255
                elif loc_btn.is_clicked(mouse_pos): current_state = STATE_LOCATIONS
                elif set_btn.is_clicked(mouse_pos): current_state = STATE_SETTINGS
                elif quit_btn.is_clicked(mouse_pos): running = False
            elif current_state == STATE_LOCATIONS:
                for i, btn in enumerate(loc_buttons):
                    if btn.is_clicked(mouse_pos): current_location = list(LOCATIONS.keys())[i]
                if back_btn.is_clicked(mouse_pos): current_state = STATE_MENU
            elif current_state == STATE_SETTINGS:
                if back_btn.is_clicked(mouse_pos): current_state = STATE_MENU
                vol_slider.handle_event(mouse_pos[0])
            elif current_state == STATE_GAME_OVER:
                if back_btn.is_clicked(mouse_pos): current_state = STATE_MENU

    #  Логика смерти 
    if current_state == STATE_DYING:
        dying_timer += dt
        progress = min(dying_timer / DYING_DURATION, 1.0)

        # Исчезновение игрока
        player.alpha = max(0, 255 - int(255 * progress))

        # Появление надписи 
        you_died_alpha = min(255, int(255 * progress * 1.5))
        you_died_y = SCREEN_HEIGHT - 50 - int(100 * progress)  # поднимается вверх

        if dying_timer >= DYING_DURATION:
            current_state = STATE_GAME_OVER

    elif current_state == STATE_GAME:
        keys = pygame.key.get_pressed()
        if keys[pygame.K_ESCAPE]:
            current_state = STATE_MENU

        if not fight_mode and not boss_fight and keys[pygame.K_q]:
            if current_enemy_index < len(enemy_types) - 1:
                current_enemy_index += 1
                et = enemy_types[current_enemy_index]
                enemy = Enemy(et["name"], et["color"], et["speed"], et["ranged"])
                fight_mode = True
                time_left = time_limit
            elif current_enemy_index == len(enemy_types) - 1:
                boss = Boss()
                boss_fight = True

        dx = dy = 0
        if keys[pygame.K_a] or keys[pygame.K_LEFT]: dx = -player.speed
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]: dx = player.speed
        if keys[pygame.K_w] or keys[pygame.K_UP]: dy = -player.speed
        if keys[pygame.K_s] or keys[pygame.K_DOWN]: dy = player.speed
        player.move(dx, dy)

        game_over = False

        if fight_mode and enemy:
            if enemy.update(player, dt) or player.collides_with_rect(enemy.x, enemy.y, enemy.size):
                game_over = True
            time_left -= dt
            if time_left <= 0:
                fight_mode = False; enemy = None

        elif boss_fight and boss:
            if boss.update(player, dt) or player.collides_with_rect(boss.x, boss.y, boss.size):
                game_over = True

        if game_over:
            current_state = STATE_DYING
            dying_timer = 0
            player_fade_alpha = 255
            you_died_alpha = 0
            you_died_y = SCREEN_HEIGHT + 50

    # Отрисовка 
    screen.fill(LOCATIONS[current_location])

    if current_state == STATE_MENU:
        title = pygame.font.SysFont(None, 48).render("Artis Impact - Lite 123", True, WHITE)
        screen.blit(title, (SCREEN_WIDTH//2 - title.get_width()//2, 80))
        play_btn.draw(screen); loc_btn.draw(screen); set_btn.draw(screen); quit_btn.draw(screen)
    elif current_state == STATE_LOCATIONS:
        title = pygame.font.SysFont(None, 36).render("Выберите локацию", True, WHITE)
        screen.blit(title, (100, 50))
        for b in loc_buttons: b.draw(screen)
        back_btn.draw(screen)
    elif current_state == STATE_SETTINGS:
        title = pygame.font.SysFont(None, 36).render("Настройки", True, WHITE)
        screen.blit(title, (100, 150))
        vol_text = small_font.render(f"Громкость: {int(settings.volume)}%", True, WHITE)
        screen.blit(vol_text, (200, 220))
        vol_slider.draw(screen)
        back_btn.draw(screen)
    elif current_state == STATE_GAME or current_state == STATE_DYING:
        player.draw(screen)
        if fight_mode and enemy:
            enemy.draw(screen)
            timer_text = small_font.render(f"Выживите: {max(0, int(time_left))} сек", True, WHITE)
            screen.blit(timer_text, (10, 10))
            name_text = small_font.render(f"Враг: {enemy.name}", True, WHITE)
            screen.blit(name_text, (10, 50))
        elif boss_fight and boss:
            boss.draw(screen)
            boss_text = small_font.render("БОСС!", True, PURPLE)
            screen.blit(boss_text, (SCREEN_WIDTH//2 - boss_text.get_width()//2, 20))
        if current_state == STATE_DYING:
            # Рисуем YOU DIED с прозрачностью
            you_died_text = font.render("YOU DIED", True, RED)
            text_surface = pygame.Surface((you_died_text.get_width(), you_died_text.get_height()), pygame.SRCALPHA)
            text_surface.blit(you_died_text, (0, 0))
            text_surface.set_alpha(you_died_alpha)
            screen.blit(text_surface, (SCREEN_WIDTH//2 - you_died_text.get_width()//2, you_died_y))
        else:
            hint = small_font.render("Q — вызвать врага | ESC — меню", True, WHITE)
            screen.blit(hint, (10, SCREEN_HEIGHT - 30))
    elif current_state == STATE_GAME_OVER:
        # Финальный экран
        you_died_text = font.render("YOU DIED", True, RED)
        screen.blit(you_died_text, (SCREEN_WIDTH//2 - you_died_text.get_width()//2, SCREEN_HEIGHT//2 - 50))
        back_btn.draw(screen)

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()
